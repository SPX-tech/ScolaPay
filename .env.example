# ============================================================
# SCOLAPAY — Déploiement Docker
# ============================================================
# Copier ce fichier en .env et ajuster les valeurs
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edu_cash

# --- Backend API ---
BACKEND_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/edu_cash?schema=public
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRY_SECONDS=28800

# --- Worker Outbox (notifications SMS) ---
# Polling automatique des événements outbox (toutes les minutes).
# Mettre à "false" pour désactiver le cron (tests, CI, instance non-worker).
OUTBOX_POLLING_ENABLED=true

# --- SMS Africa's Talking ---
# Sans AT_API_KEY, les SMS sont simulés (mock) dans les logs.
# Renseigner ces variables pour activer l'envoi réel.
# AT_API_KEY=
# AT_USERNAME=sandbox
# AT_SENDER_ID=

# --- Web Dashboard ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1
PAYMENT_PROVIDER=disabled
