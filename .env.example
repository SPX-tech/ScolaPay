# ============================================================
# EDU-CASH — Déploiement Docker
# ============================================================
# Copier ce fichier en .env et ajuster les valeurs
#   cp .env.example .env
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edu_cash

# --- Backend API ---
BACKEND_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/edu_cash?schema=public
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRY_SECONDS=28800

# --- Web Dashboard ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
