DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_cash?schema=public"
PORT=3000
ACCESS_TOKEN_SECRET="change-me-in-production"
ACCESS_TOKEN_EXPIRY_SECONDS=28800

# --- Worker Outbox (notifications SMS) ---
# Polling automatique des événements outbox (toutes les minutes).
# Mettre à "false" pour désactiver le cron (tests, CI, instance non-worker).
OUTBOX_POLLING_ENABLED=true

# --- SMS Africa's Talking ---
# Sans AT_API_KEY, les SMS sont simulés (mock) dans les logs.
# Renseigner ces variables pour activer l'envoi réel.
# AT_API_KEY=
# AT_USERNAME=sandbox
# AT_SENDER_ID=
