generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TENANT_ADMIN
  CASHIER
  ACCOUNTANT
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  CASH_PAYMENT
  DEBT_ADJUSTMENT
  REFUND
  MOBILE_PAYMENT
  WITHDRAWAL
}

enum WithdrawalMethod {
  MOBILE_MONEY
  BANK_TRANSFER
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  VOIDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum LedgerEntryType {
  PAYMENT
  WITHDRAWAL
  FEE
  ADJUSTMENT
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  currency  String   @default("XAF")
  timezone  String   @default("Africa/Ndjamena")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  students           Student[]
  classes            SchoolClass[]
  transactions       Transaction[]
  outboxEvents       OutboxEvent[]
  auditLogs          AuditLog[]
  virtualAccount     VirtualAccount?
  withdrawalRequests WithdrawalRequest[]
  ledgerEntries      LedgerEntry[]

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  phone        String?
  fullName     String
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordedTransactions Transaction[]       @relation("RecordedByUser")
  withdrawalRequests   WithdrawalRequest[] @relation("RequestedWithdrawals")

  @@unique([tenantId, email])
  @@index([tenantId, role, status])
  @@map("users")
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  classId       String?
  studentNumber String
  fullName      String
  guardianPhone String?
  guardianName  String?
  status        StudentStatus @default(ACTIVE)
  debtCents     BigInt        @default(0)
  creditCents   BigInt        @default(0)
  enrolledAt    DateTime?
  lastPaymentAt DateTime?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  class        SchoolClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([tenantId, studentNumber])
  @@index([tenantId, status])
  @@index([tenantId, classId])
  @@index([tenantId, fullName])
  @@map("students")
}

model Transaction {
  id                String            @id @default(cuid())
  tenantId          String
  studentId         String
  recordedByUserId  String
  type              TransactionType   @default(CASH_PAYMENT)
  status            TransactionStatus @default(POSTED)
  amountCents       BigInt
  previousDebtCents BigInt
  newDebtCents      BigInt
  currency          String            @default("XAF")
  /// Nul tant que la transaction n'est pas POSTED : un paiement PENDING n'a
  /// encore rien à prouver. Généré à la confirmation (webhook).
  receiptNumber     String?
  receiptHash       String?           @db.VarChar(64)
  qrCodeData        String?
  idempotencyKey    String?
  note              String?
  metadata          Json?
  /// Référence marchande générée par nous à l'initiation d'un paiement
  /// numérique (MOBILE_PAYMENT) et transmise au prestataire : unique
  /// globalement (pas seulement par tenant) pour que le webhook public,
  /// qui n'a aucun contexte tenant, puisse retrouver la transaction.
  providerReference String?           @unique
  /// Numéro effectivement débité lors d'un paiement numérique (peut
  /// différer du guardianPhone de la fiche élève).
  payerPhone        String?
  recordedAt        DateTime          @default(now())
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("RecordedByUser", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, studentId, recordedAt])
  @@index([tenantId, recordedByUserId, recordedAt])
  @@index([tenantId, type, status])
  @@index([tenantId, recordedAt])
  @@index([tenantId, status, recordedAt])
  @@map("transactions")
}

model SchoolClass {
  id           String      @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  academicYear String
  status       ClassStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  students Student[]

  @@unique([tenantId, name, academicYear])
  @@index([tenantId, status])
  @@index([tenantId, academicYear])
  @@map("school_classes")
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  publishedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, availableAt])
  @@index([eventType, status])
  @@map("outbox_events")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String
  actorUserId String
  action      String
  targetType  String
  targetId    String
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@index([tenantId, targetType, targetId])
  @@map("audit_logs")
}

model VirtualAccount {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  balanceCents           BigInt   @default(0)
  pendingWithdrawalCents BigInt   @default(0)
  currency               String   @default("XAF")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@map("virtual_accounts")
}

model WithdrawalRequest {
  id                String           @id @default(cuid())
  tenantId          String
  amountCents       BigInt
  method            WithdrawalMethod
  destination       String
  status            WithdrawalStatus @default(PENDING)
  reference         String           @unique
  /// Référence du prestataire mobile money/bancaire, saisie manuellement
  /// lors de la finalisation (Phase 1 : pas d'intégration provider).
  externalReference String?
  /// Motif renseigné lors d'un passage en FAILED.
  failureReason     String?
  requestedById     String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedBy User   @relation("RequestedWithdrawals", fields: [requestedById], references: [id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@index([tenantId, status, createdAt])
  @@map("withdrawal_requests")
}

/// Grand livre immuable des mouvements réels du compte virtuel (VirtualAccount).
/// Source de vérité comptable : balanceCents sur VirtualAccount n'est qu'une
/// projection dénormalisée, recalculable en sommant amountCents de ces lignes.
/// Les lignes ne sont JAMAIS modifiées ni supprimées après création (voir le
/// trigger Postgres ledger_entries_immutable ajouté en migration).
model LedgerEntry {
  id                   String          @id @default(cuid())
  tenantId             String
  virtualAccountId     String
  /// Signé : positif = crédit, négatif = débit.
  amountCents          BigInt
  /// Solde du compte immédiatement après application de cette ligne.
  balanceAfterCents    BigInt
  type                 LedgerEntryType
  /// Clé d'idempotence : une même reference ne peut être postée deux fois.
  reference            String          @unique
  relatedTransactionId String?
  relatedWithdrawalId  String?
  metadata             Json?
  createdAt            DateTime        @default(now())

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  virtualAccount     VirtualAccount     @relation(fields: [virtualAccountId], references: [id], onDelete: Restrict)
  relatedTransaction Transaction?       @relation(fields: [relatedTransactionId], references: [id], onDelete: Restrict)
  relatedWithdrawal  WithdrawalRequest? @relation(fields: [relatedWithdrawalId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([virtualAccountId, createdAt])
  @@index([tenantId, type, createdAt])
  @@map("ledger_entries")
}
