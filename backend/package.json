{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm test -- --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "npm run prisma:generate && npm run build && node dist/prisma/seed.js",
    "prisma:studio": "prisma studio",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/schedule": "12.0.2",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.3",
    "@types/babel__generator": "7.27.0",
    "@types/babel__template": "7.4.4",
    "@types/babel__traverse": "7.28.0",
    "@types/body-parser": "1.19.6",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/jest": "30.0.0",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.19.2",
    "@types/qs": "6.15.1",
    "@types/range-parser": "1.2.7",
    "@types/send": "1.2.1",
    "@types/supertest": "7.2.1",
    "@types/yargs-parser": "21.0.3",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "prisma": "7.10.1",
    "@types/pg": "8.23.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
